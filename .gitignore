# Project ignore rules
# Build artifacts
/dist
/build
/.next
/public/dist

# Node modules and caches
/node_modules
/.cache
/.parcel-cache

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Source maps
*.map

# OS files
.DS_Store

# Env files
.env
.env.local

# IDE/editor
.vscode/
*.sublime-project
*.sublime-workspace

# TypeScript
*.tsbuildinfo

# Misc
coverage/

# Ignore app-specific generated assets
assets/dist/

# Keep src/types.ts tracked (explicitly listed previously) — do not ignore
